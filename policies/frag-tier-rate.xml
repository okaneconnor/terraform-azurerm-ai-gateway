<fragment>
  <!-- Default-preset rate limit; skipped when the registry seam policied this caller. -->
  <choose>
    <when condition="@(!context.Variables.ContainsKey(&quot;team-policied&quot;))">
      <rate-limit-by-key calls="${t.rate_limit_calls}" renewal-period="${renewal}" counter-key="@(&quot;tier|&quot; + (string)context.Variables[&quot;caller-app-id&quot;])" />
    </when>
  </choose>
</fragment>
