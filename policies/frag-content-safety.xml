<fragment>
  <!-- Platform content safety; skipped when a per-team rendering replaced it (team-cs-policied). -->
  <choose>
    <when condition="@(!context.Variables.ContainsKey(&quot;team-cs-policied&quot;))">
      <llm-content-safety backend-id="${cs_backend_id}" shield-prompt="${shield_prompt}" enforce-on-completions="${enforce_on_completions}">
        <categories output-type="EightSeverityLevels">
          <category name="Hate" threshold="${category_threshold}" />
          <category name="Violence" threshold="${category_threshold}" />
          <category name="SelfHarm" threshold="${category_threshold}" />
          <category name="Sexual" threshold="${category_threshold}" />
        </categories>
      </llm-content-safety>
    </when>
  </choose>
</fragment>
