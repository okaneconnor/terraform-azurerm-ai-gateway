<policies>
  <inbound>
    <base />
    <include-fragment fragment-id="ai-ip-allow" />
    <include-fragment fragment-id="ai-auth-entra-jwt" />
    <!-- Registry seam first: registered callers get their own limits inline and
         set team-policied, which the tier fragments honour by skipping. -->
    <include-fragment fragment-id="ai-team-overrides" />
    <include-fragment fragment-id="ai-tier-rate" />
    <include-fragment fragment-id="ai-tier-tokens" />
    <!-- As<JObject>() THROWS on a body that is not valid JSON, and an unhandled
         throw here leaves the pipeline as a 500 with no taxonomy body — which both
         looks like a gateway fault to the caller (SDKs retry it) and pages us on the
         5xx alert. Parse once, defensively, and treat unparseable as what it is: a
         bad request. -->
    <set-variable name="body-valid" value="@{
        try {
            var b = context.Request.Body?.As&lt;JObject&gt;(preserveContent: true);
            return b != null &amp;&amp; b[&quot;model&quot;] != null &amp;&amp; b[&quot;messages&quot;] != null;
        } catch (Exception) { return false; }
    }" />
    <set-variable name="requested-model" value="@{
        try {
            var b = context.Request.Body?.As&lt;JObject&gt;(preserveContent: true);
            return b != null &amp;&amp; b[&quot;model&quot;] != null ? (string)b[&quot;model&quot;] : &quot;&quot;;
        } catch (Exception) { return &quot;&quot;; }
    }" />
    <choose>
      <when condition="@(!(bool)context.Variables[&quot;body-valid&quot;])">
        <return-response>
          <set-status code="400" reason="Bad Request" />
          <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
          <set-header name="x-correlation-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
          <set-body>{"error":{"message":"Request body must be valid JSON containing model and messages.","type":"invalid_request_error","code":"invalid_request"}}</set-body>
        </return-response>
      </when>
    </choose>
    <set-variable name="deployment" value="@{
        var model = (string)context.Variables[&quot;requested-model&quot;];
        switch (model) {
%{ for canonical, deployment in model_map ~}
          case &quot;${canonical}&quot;: return &quot;${deployment}&quot;;
%{ endfor ~}
          default: return &quot;&quot;;
        }
    }" />
    <choose>
      <when condition="@(string.IsNullOrEmpty((string)context.Variables[&quot;deployment&quot;]))">
        <return-response>
          <set-status code="404" reason="Not Found" />
          <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
          <set-header name="x-correlation-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
          <set-body>{"error":{"message":"Unknown model. Request a model by its canonical name from the gateway's published list.","type":"invalid_request_error","code":"model_not_found"}}</set-body>
        </return-response>
      </when>
    </choose>
    <include-fragment fragment-id="ai-model-allowlist" />
    <rewrite-uri template="@($"/deployments/{(string)context.Variables[&quot;deployment&quot;]}/chat/completions?api-version=${api_version}")" copy-unmatched-params="false" />
    <!-- backend-mi must precede content-safety: the llm-content-safety call rides
         on the Authorization header, which this fragment swaps to the MSI token. -->
    <include-fragment fragment-id="ai-backend-managed-identity" />
%{ if content_safety_enabled ~}
    <!-- Before the cache: cache hits must not bypass Prompt Shield. Team CS
         first — it sets team-cs-policied, which platform CS honours by skipping. -->
    <include-fragment fragment-id="ai-team-content-safety" />
    <include-fragment fragment-id="ai-content-safety" />
%{ endif ~}
%{ if semantic_cache_enabled ~}
    <llm-semantic-cache-lookup score-threshold="${score_threshold}" embeddings-backend-id="embeddings-backend" embeddings-backend-auth="system-assigned" ignore-system-messages="true">
      <vary-by>@((string)context.Variables[&quot;caller-app-id&quot;])</vary-by>
      <!-- Without the deployment, the same prompt asked of two different models
           returns whichever answer was cached first. -->
      <vary-by>@((string)context.Variables[&quot;deployment&quot;])</vary-by>
    </llm-semantic-cache-lookup>
%{ endif ~}
    <set-backend-service backend-id="foundry-pool" />
    <include-fragment fragment-id="ai-token-metrics" />
  </inbound>
  <backend><base /></backend>
  <outbound>
    <base />
%{ if semantic_cache_enabled ~}
    <llm-semantic-cache-store duration="${cache_duration}" />
%{ endif ~}
    <set-header name="x-correlation-id" exists-action="override">
      <value>@(context.RequestId.ToString())</value>
    </set-header>
  </outbound>
  <on-error>
    <base />
    <include-fragment fragment-id="ai-error-taxonomy" />
  </on-error>
</policies>
